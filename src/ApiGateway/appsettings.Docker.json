{
  "ReverseProxy": {
    "Routes": {
      "auth-route": { "ClusterId": "auth-cluster", "Match": { "Path": "/api/auth/{**catch-all}" } },
      "products-route": { "ClusterId": "products-cluster", "Match": { "Path": "/api/products/{**catch-all}" } },
      "orders-route": { "ClusterId": "orders-cluster", "Match": { "Path": "/api/orders/{**catch-all}" } }
    },
    "Clusters": {
      "auth-cluster": { "Destinations": { "destination1": { "Address": "http://authservice:8080/" } } },
      "products-cluster": { "Destinations": { "destination1": { "Address": "http://productservice:8080/" } } },
      "orders-cluster": { "Destinations": { "destination1": { "Address": "http://orderservice:8080/" } } }
    }
  }
}
